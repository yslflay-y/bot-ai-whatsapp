{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "Production-ready self-hosted WhatsApp AI Assistant",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bullmq": "^5.41.6",
    "cheerio": "^1.0.0",
    "cron-parser": "^5.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.6.0",
    "openai": "^4.86.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.9",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
